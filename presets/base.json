{
  "version": 8,

  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },

  "configurePresets": [
    {
      "name": "sibling-build",
      "description": "Sibling build",
      "hidden": true,
      "binaryDir": "${sourceParentDir}/${sourceDirName}-build"
    },
    {
      "name": "subdirectory-build",
      "description": "Subdirectory build",
      "hidden": true,
      "binaryDir": "build"
    },
    {
      "name": "clang",
      "displayName": "Clang",
      "description": "Default options for the Clang compiler",
      "toolchainFile": "${sourceDir}/toolchains/toolchain-clang.cmake",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_C_COMPILER": "clang"
      }
    },
    {
      "name": "gcc",
      "displayName": "GCC",
      "description": "Default build options for GCC",
      "toolchainFile": "${sourceDir}/toolchains/toolchain-gcc.cmake",
      "cacheVariables": {
        "CMAKE_C_FLAGS": "-Wall -Wextra -pedantic",
        "CMAKE_CXX_FLAGS": "-Wall -Wextra -pedantic"
      }
    },
    {
      "name": "base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_SUITE_TESTS":  "OFF",
        "BUILD_CLIENT_TESTS": "OFF",
        "BUILD_UNIT_TESTS":   "OFF"
      }
    },
    {
      "name": "ci-base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_SUITE_TESTS":  "ON",
        "BUILD_CLIENT_TESTS": "ON",
        "BUILD_UNIT_TESTS":   "ON"
      }
    },
    {
      "name": "vcpkg",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_USE_VCPKG": true
      }
    }
  ],

  "buildPresets": [
    {
      "name": "ci-install-package",
      "description": "Install a package",
      "hidden": true,
      "targets": ["install-package"]
    },
    {
      "name": "ci-test-client",
      "description": "Client Tests",
      "hidden": true,
      "targets": ["test"]
    },
    {
      "name": "ci-test-suite",
      "description": "Suite Tests",
      "hidden": true,
      "targets": ["suite"]
    }
  ],

  "packagePresets": [
    {
      "name": "ci-base",
      "hidden": true,
      "configurations": [ "Release" ],
      "generators": [ "TGZ", "TBZ2" ],
      "packageDirectory": "dist"
    }
  ]
}
